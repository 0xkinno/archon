# ==============================================================================
# ARCHON Environment Configuration
# ==============================================================================

# Google Cloud Platform & Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=archon-enterprise-fleet
GCP_LOCATION=us-central1

# Storage & Firestore
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

# GEAP Governance & Feature Flags
USE_MEMORY_BANK=true
USE_AGENT_RUNTIME=true
USE_MODEL_ARMOR=true
APPROVAL_THRESHOLD=10000.00
RATE_LIMIT_TOOL_CALLS=20

# Agent Identity & Security
JWT_SECRET=archon_super_secure_enterprise_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# Backend Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://archon-app.vercel.app

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
